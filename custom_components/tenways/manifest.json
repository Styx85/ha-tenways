{
  "domain": "tenways",
  "name": "TENWAYS BLE",
  "version": "0.3.1",
  "documentation": "https://github.com/OWNER/ha-tenways",
  "issue_tracker": "https://github.com/OWNER/ha-tenways/issues",
  "codeowners": [],
  "config_flow": true,
  "integration_type": "device",
  "iot_class": "local_polling",
  "dependencies": [
    "bluetooth"
  ],
  "requirements": [
    "bleak-retry-connector>=3.6.0"
  ],
  "bluetooth": [
    {
      "local_name": "Tenways-ble-*",
      "connectable": true
    },
    {
      "local_name": "Longtail Duo",
      "connectable": true
    }
  ],
  "after_dependencies": [
    "bluetooth_adapters"
  ]
}
